# ============================================================
# DDLJ Trading System — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# NEVER commit .env to Git! It's already in .gitignore.
# On Railway, set these in the Environment Variables panel.
# ============================================================

# ── Kite API Credentials ──
# Get these from https://kite.trade
# MANDATORY — The server will not start without these.
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here

# ── Database ──
# Supabase PostgreSQL connection string (set after creating Supabase project)
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# If empty, the system uses local SQLite for development (no setup needed).
DATABASE_URL=

# ── Telegram Notifications (Optional but Recommended) ──
# Create a bot via @BotFather on Telegram
# Get your chat ID by messaging @userinfobot
# If both are set, you'll receive trade alerts on Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Application Settings ──
# Environment: "development" or "production"
# - development: console logging, auto-reload, SQLite fallback
# - production: JSON logging, no reload, requires DATABASE_URL
APP_ENV=development

# Server host and port (for local development)
# Railway sets PORT automatically — don't change in production.
HOST=0.0.0.0
PORT=8000

# ── Logging ──
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG shows every candle processed — very verbose.
# INFO is recommended for normal operation.
LOG_LEVEL=INFO

# ── Security ──
# A secret key for JWT authentication (future use).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET_KEY=

# ── Feature Flags ──
# Set to "false" to disable any feature.
ENABLE_PAPER_TRADING=true
ENABLE_WEBSOCKET=true
ENABLE_SESSION_RECOVERY=true
ENABLE_MARKET_HOURS_GUARD=true
ENABLE_TOKEN_AUTO_REFRESH=true

# ── Project Root (Optional) ──
# Set this if the auto-detection doesn't work.
# Auto-detected from the directory structure, so usually not needed.
# PROJECT_ROOT=/app

# ── Frontend URL (For CORS) ──
# Set this to your Vercel deployment URL for production.
# Example: FRONTEND_URL=https://ddlj-dashboard.vercel.app
FRONTEND_URL=
