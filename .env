# ============================================================
# DDLJ Trading System — Environment Variables
# ============================================================
# NEVER commit this file to Git! Add .env to .gitignore.
# On Railway, set these in the Environment Variables panel.
# ============================================================

# ── Kite API Credentials ──
# Get these from https://kite.trade
KITE_API_KEY=cjzjv3v9y3lox6mh
KITE_API_SECRET=tkg39m07fqan0h1yzirpyilmvovf9gr8

# ── Database ──
# Supabase PostgreSQL connection string (set after creating Supabase project)
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# ── Telegram Notifications (Optional) ──
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Application Settings ──
# Environment: "development" or "production"
APP_ENV=development

# Server host and port (for local development)
HOST=0.0.0.0
PORT=8000

# ── Security ──
# A secret key for JWT auth (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
AUTH_SECRET_KEY=
